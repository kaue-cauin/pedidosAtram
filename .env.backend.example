# Inert template. Fill locally; never paste this file into chat or commit local values.
DATABASE_URL=
BACKEND_ORIGIN=http://127.0.0.1:8790
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8790
BACKEND_ALLOW_LOOPBACK_HTTP=yes
BACKEND_SESSION_SECONDS=28800
# JSON map of key version -> 32 random bytes as 64 hexadecimal characters
BACKEND_ENCRYPTION_KEYS=
BACKEND_ACTIVE_KEY=
# Production: TLS DB required unless explicitly attesting protected private network
BACKEND_DATABASE_PRIVATE_NETWORK=no
TINY_BACKEND_OAUTH_ENABLED=no
TINY_BACKEND_READ_ENABLED=no
TINY_BACKEND_REFRESH_ENABLED=no
TINY_BACKEND_CLIENT_ID=
TINY_BACKEND_CLIENT_SECRET=
TINY_BACKEND_CALLBACK=http://127.0.0.1:8790/api/erp/tiny/oauth/callback

# Etapa 7B.3: no sync on startup; only explicit authenticated ADMIN actions.
TINY_BACKEND_SYNC_ENABLED=no
BACKEND_SYNC_FIXTURE_ENABLED=no
BACKEND_SYNC_PAGE_SIZE=25
BACKEND_SYNC_MAX_PAGES=500
BACKEND_SYNC_MAX_RECORDS=10000
BACKEND_SYNC_MAX_ATTEMPTS=3
# Conservative application budget, NOT the verified quota of the Tiny account.
BACKEND_SYNC_INTERVAL_MS=4000
# Optional, bounded detail phase; no blanket detail lookup.
TINY_BACKEND_DETAIL_ENABLED=no
