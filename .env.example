# Etapa 1 usa somente dados locais fictícios. Nenhuma variável é necessária.
# Copie este arquivo para .env.local se quiser reservar configuração local.
# Nunca coloque credenciais reais ou tokens em variáveis NEXT_PUBLIC_*.
# POC 7B.1: somente ambiente Node local confiável; nunca usada pelo frontend.
# Exemplo inerte: nenhum valor real. Não ative antes de confirmar os sete pré-requisitos.
TINY_POC_APPROVED=no
TINY_POC_ACCOUNT_DOCUMENT=
TINY_POC_PLAN=
TINY_POC_USER=
TINY_POC_CLIENT_ID=
TINY_POC_CLIENT_SECRET=
TINY_POC_ADMIN_KEY=
TINY_POC_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
TINY_POC_READ_RESOURCES=info,products,contacts,sellers,priceLists
# pending bloqueia execução. Confirmar suporte: confirmed-s256 OU confirmed-unsupported.
TINY_POC_PKCE_SUPPORT=pending
TINY_POC_REFRESH_AUTHORIZED=no
# Detalhes somente com autorização específica, ID pré-definido e recurso na allowlist.
TINY_POC_PRODUCT_ID=
TINY_POC_PRICE_LIST_ID=
